{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "schedule:monthly"],
  "prHourlyLimit": 0,
  "automerge": true,
  "automergeStrategy": "rebase",
  "pre-commit": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Majors that need manual attention",
      "matchPackageNames": ["ansible-core"],
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Debian bumps may also need the rbw builder stage moved",
      "matchDepNames": ["mcr.microsoft.com/devcontainers/base"],
      "versioning": "regex:^debian-(?<major>\\d+)$",
      "automerge": false
    }
  ]
}
