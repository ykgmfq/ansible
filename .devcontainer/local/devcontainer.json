{
  "name": "ansible and butane (local build)",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "..",
    "args": {
      "DEBIAN_TAG": "13",
      "BUILDKIT_INLINE_CACHE": "1"
    }
  },
  "runArgs": [
    "--network=dev6"
  ],
  "mounts": [
    "source=rbw-config,target=/home/vscode/.config/rbw,type=volume",
    "source=rbw-data,target=/home/vscode/.local/share/rbw,type=volume"
  ],
  // Fresh named volumes are root-owned.
  "postCreateCommand": "sudo chown vscode: /home/vscode/.config/rbw /home/vscode/.local/share/rbw",
  "customizations": {
    "vscode": {
      "extensions": [
        "redhat.vscode-yaml",
        "redhat.ansible",
        "nefrob.vscode-just-syntax",
        "Anthropic.claude-code",
        "GitHub.vscode-github-actions"
      ]
    }
  }
}
