{
  "name": "ansible and butane (local build)",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "..",
    "args": {
      "DEBIAN_TAG": "13",
      "BUILDKIT_INLINE_CACHE": "1"
    }
  },
  "runArgs": [
    "--network=dev6"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "redhat.vscode-yaml",
        "redhat.ansible",
        "nefrob.vscode-just-syntax",
        "Anthropic.claude-code",
        "GitHub.vscode-github-actions"
      ]
    }
  }
}
