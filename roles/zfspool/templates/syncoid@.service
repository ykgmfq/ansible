[Unit]
After = network-online.target dev-disk-by\x2dlabel-{{ hostname | replace('-', '\\x2d') }}.device
Requires = network-online.target dev-disk-by\x2dlabel-{{ hostname | replace('-', '\\x2d') }}.device
# The timer resets the start limit each cycle
StartLimitIntervalSec = 1h
StartLimitBurst = 3

[Service]
User = syncoid
Type = oneshot
Restart = on-failure
RestartSec = 10min
TimeoutStartSec = 12h
ExecStart = /usr/sbin/syncoid --preserve-recordsize --recursive --no-sync-snap --no-privilege-elevation --compress=zstd-fast --sshkey=%h/.ssh/id_ed25519 --sshoption=StrictHostKeyChecking=accept-new {{ groups['appserver'][0] }}:{{ hostvars[groups['appserver'][0]].hostname }}/%i {{ hostname }}/%i
