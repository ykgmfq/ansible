[Unit]
Description=Publish this host's IPv6 address to the DynDNS provider as an AAAA record
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/fish /usr/local/bin/dyndns.fish
Environment=DYNDNS_ENDPOINT={{ dyndns_endpoint }}
Environment=DYNDNS_HOSTNAME={{ inventory_hostname }}
LoadCredential=dyndns-password:{{ dyndns_password_credential_path }}
StateDirectory=dyndns
