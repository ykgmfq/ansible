{
	"folders": [
		{
			"path": "."
		}
	],
	"settings": {
		"files.associations": {
			"*.butane": "yaml",
			"inventory.yml": "ansible",
			"playbooks/**/*.yml": "ansible",
			"roles/**/*.yml": "ansible",
			"group_vars/**/*.yml": "ansible"
		},
	},
	"tasks": {
		"version": "2.0.0",
		"tasks": [
			{
				"label": "playbook-check",
				"type": "process",
				"command": "just",
				"args": [
					"playbook-check",
					"${input:playbook}"
				],
				"problemMatcher": [],
				"group": {
					"kind": "test",
					"isDefault": true
				}
			},
			{
				"label": "playbook-check-verbose",
				"type": "process",
				"command": "just",
				"args": [
					"playbook-check-verbose",
					"${input:playbook}"
				],
				"problemMatcher": [],
				"group": "test"
			},
			{
				"label": "playbook-verbose",
				"type": "process",
				"command": "just",
				"args": [
					"playbook-verbose",
					"${input:playbook}"
				],
				"problemMatcher": [],
				"group": "build"
			},
			{
				"label": "playbook",
				"type": "process",
				"command": "just",
				"args": [
					"playbook",
					"${input:playbook}"
				],
				"problemMatcher": [],
				"group": {
					"kind": "build",
					"isDefault": true
				}
			},
			{
				"label": "butane",
				"type": "process",
				"command": "just",
				"args": [
					"butane"
				],
				"problemMatcher": [],
				"group": "build"
			},
			{
				"label": "galaxy",
				"type": "process",
				"command": "just",
				"args": [
					"galaxy"
				],
				"problemMatcher": []
			},
			{
				"label": "ignition",
				"type": "process",
				"command": "just",
				"args": [
					"ignition"
				],
				"problemMatcher": []
			}
		],
		"inputs": [
			{
				"id": "playbook",
				"type": "pickString",
				"description": "Playbook",
				"options": [
					"servers",
					"network",
					"router_prep"
				],
				"default": "servers"
			}
		]
	},
	"extensions": {
		"recommendations": [
			"redhat.vscode-yaml",
			"wholroyd.jinja",
			"redhat.ansible",
			"anthropic.claude-code",
			"github.vscode-github-actions"
		]
	}
}
