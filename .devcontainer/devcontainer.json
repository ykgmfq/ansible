{
  "name": "ansible and butane",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "DEBIAN_TAG": "13"
    }
  },
  "runArgs": ["--network=dev6"],
  "customizations": {
    "vscode": {
      "extensions": [
        "redhat.vscode-yaml",
        "redhat.ansible",
        "nefrob.vscode-just-syntax",
        "Anthropic.claude-code",
        "GitHub.vscode-github-actions"
      ]
    }
  }
}
